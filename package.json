{
  "name": "openskatemap-cloud",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "apps/*",
    "apps/web/landing",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run --parallel --no-exit-on-error lint typecheck test openapi:check build",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "typecheck": "bun run --filter '*' typecheck",
    "typecheck:tsc": "bun run --filter '*' typecheck:tsc",
    "test": "bun run --filter '*' test",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "bun run --filter @openskatemap/db generate",
    "db:migrate": "bun run --filter @openskatemap/db migrate",
    "openapi": "bun run --filter @openskatemap/api openapi",
    "openapi:check": "bun run --filter @openskatemap/api openapi:check",
    "build": "bun run --filter @openskatemap/api --filter @openskatemap/web build",
    "dev": "bun run --filter @openskatemap/api dev",
    "deploy": "bun run apps/api/scripts/deploy.ts"
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "eslint-plugin-astro": "^3.2.1"
  }
}
